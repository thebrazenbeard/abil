{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thebrazenbeard/abil/docs/AUTHORITY_STATE_READ_RECEIPT_V1.schema.json",
  "title": "ABIL Authority State Read Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "target_id",
    "reader_identity",
    "reconciliation_subject",
    "read_at",
    "fresh_until",
    "freshness_profile_id",
    "freshness_profile_digest",
    "canonicalization_profile_id",
    "canonicalization_profile_digest",
    "freshness_status",
    "completeness_status",
    "authority_surface_profile_id",
    "authority_surface_profile_digest",
    "required_authority_surface_ids",
    "required_surface_set_digest",
    "authority_surface_reads",
    "reconciled_authority_surface_ids",
    "reconciled_surface_set_digest",
    "current_authority_epoch",
    "epoch_set",
    "max_observed_authority_epoch",
    "epoch_set_digest",
    "authority_state_digest"
  ],
  "properties": {
    "schema_id": {"const": "ABIL_AUTHORITY_STATE_READ_RECEIPT_V1"},
    "target_id": {"type": "string", "minLength": 1},
    "reader_identity": {"type": "string", "minLength": 1},
    "reconciliation_subject": {"type": "string", "minLength": 1},
    "read_at": {"type": "string", "format": "date-time"},
    "fresh_until": {"type": "string", "format": "date-time"},
    "freshness_profile_id": {"type": "string", "minLength": 1},
    "freshness_profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonicalization_profile_id": {"type": "string", "minLength": 1},
    "canonicalization_profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "freshness_status": {"enum": ["FRESH", "STALE", "UNKNOWN"]},
    "completeness_status": {"enum": ["COMPLETE", "PARTIAL", "CONFLICTING", "UNKNOWN"]},
    "authority_surface_profile_id": {"type": "string", "minLength": 1},
    "authority_surface_profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "required_authority_surface_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "required_surface_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_surface_reads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authority_surface_id",
          "observed_subject",
          "read_at",
          "fresh_until",
          "authority_state_digest"
        ],
        "properties": {
          "authority_surface_id": {"type": "string", "minLength": 1},
          "observed_subject": {"type": "string", "minLength": 1},
          "read_at": {"type": "string", "format": "date-time"},
          "fresh_until": {"type": "string", "format": "date-time"},
          "authority_state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "reconciled_authority_surface_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "reconciled_surface_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "current_authority_epoch": {"type": "integer", "minimum": 0},
    "epoch_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority_epoch", "state"],
        "properties": {
          "authority_epoch": {"type": "integer", "minimum": 0},
          "state": {"enum": ["CURRENT", "REVOKED", "SUPERSEDED"]}
        }
      }
    },
    "max_observed_authority_epoch": {"type": "integer", "minimum": 0},
    "epoch_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "notes": {"type": ["string", "null"]}
  }
}
